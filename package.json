{
    "name": "pptb-optionset-manager",
    "version": "0.3.8",
    "type": "module",
    "displayName": "OptionSet Manager",
    "description": "Create, modify, and manage local and global Dataverse OptionSets (Choice fields) with bulk operations, import/export, and multi-language support.",
    "main": "index.html",
    "icon": "assets/icon.svg",
    "license": "MIT",
    "contributors": [
        {
            "name": "Matt Berg",
            "url": "https://github.com/mattberg11"
        }
    ],
    "configurations": {
        "website": "https://github.com/mattberg11/pptb-optionset-manager",
        "repository": "https://github.com/mattberg11/pptb-optionset-manager",
        "readmeUrl": "https://raw.githubusercontent.com/mattberg11/pptb-optionset-manager/refs/heads/main/README.md"
    },
    "bugs": {
        "url": "https://github.com/mattberg11/pptb-optionset-manager/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mattberg11/pptb-optionset-manager.git"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "dataverse",
        "power-platform",
        "optionset",
        "choice",
        "metadata",
        "localization"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "lint": "eslint .",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "pnpm run build && pnpm run version-stable && npm publish --access public"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@codemirror/view": "^6.43.9",
        "@fluentui/react-components": "^9.74.0",
        "@fluentui/react-icons": "^2.0.0",
        "flag-icons": "^7.5.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@pptb/types": "^1.2.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.5.0",
        "globals": "^15.0.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.1.11"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ]
}
