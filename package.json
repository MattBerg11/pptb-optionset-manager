{
    "name": "pptb-optionset-manager",
    "version": "0.3.7",
    "type": "module",
    "displayName": "OptionSet Manager",
    "description": "Create, modify, and manage local and global Dataverse OptionSets (Choice fields) with bulk operations, import/export, and multi-language support.",
    "main": "index.html",
    "icon": "assets/icon.svg",
    "license": "MIT",
    "author": "Matt Berg",
    "contributors": [
        {
            "name": "Matt Berg",
            "url": "https://github.com/mattberg11"
        }
    ],
    "bugs": {
        "url": "https://github.com/mattberg11/pptb-optionset-manager/issues"
    },
    "configurations": {
        "website": "https://github.com/mattberg11/pptb-optionset-manager",
        "repository": "https://github.com/mattberg11/pptb-optionset-manager",
        "readmeUrl": "https://raw.githubusercontent.com/mattberg11/pptb-optionset-manager/refs/heads/main/README.md"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "lint": "eslint .",
        "finalize-package": "npm shrinkwrap",
        "validate": "pptb-validate",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "pnpm run build && pnpm run version-stable && npm publish --access public"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.74.0",
        "@fluentui/react-icons": "^2.0.0",
        "@react-code-view/react": "^3.1.0",
        "@react-code-view/unplugin": "^3.1.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@pptb/types": "^1.2.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.5.0",
        "globals": "^15.0.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.1.11"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ]
}
